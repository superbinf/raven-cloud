#!/usr/bin/env bash
set -euo pipefail

OFFLINE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
OFFLINE_LABEL="运营平台"
OFFLINE_ENTRY_NAME="raven-cloud.sh"
OFFLINE_VERSION="@@VERSION@@"
OFFLINE_ARCH="@@ARCH@@"
OFFLINE_IMAGE_TAG="@@IMAGE_TAG@@"
OFFLINE_APP_IMAGE="raven-cloud"
OFFLINE_COMPOSE_FILE="$OFFLINE_ROOT/docker-compose.yml"
OFFLINE_ENV_FILE="$OFFLINE_ROOT/.env.production"
OFFLINE_ENV_POINTER="SENTINEL_CLOUD_ENV_FILE"
OFFLINE_DEFAULT_PORT="8787"
OFFLINE_VOLUMES="sentinel-cloud_cloud_postgres_data sentinel-cloud_cloud_redis_data sentinel-cloud_cloud_data"
OFFLINE_IMAGE_ARCHIVES="images/raven-cloud-@@ARCH@@.tar images/postgres-17-@@ARCH@@.tar images/redis-7.4-@@ARCH@@.tar"
OFFLINE_REQUIRED_IMAGES="raven-cloud:@@IMAGE_TAG@@ postgres:17-alpine redis:7.4-alpine"
OFFLINE_REQUIRED_KEYS="POSTGRES_PASSWORD DATABASE_URL REDIS_URL SENTINEL_SECRET SENTINEL_ADMIN_PASSWORD SENTINEL_PORTAL_PASSWORD SENTINEL_PUBLIC_BASE_URL SENTINEL_TLS_CERT_HOST_PATH SENTINEL_TLS_KEY_HOST_PATH"
OFFLINE_FILE_KEYS="SENTINEL_TLS_CERT_HOST_PATH SENTINEL_TLS_KEY_HOST_PATH"
OFFLINE_HTTPS_URL_KEY="SENTINEL_PUBLIC_BASE_URL"

offline_initialize_config() {
  local hostname="$1" port="$2"
  local database_password master_secret admin_password portal_password feed_token
  [[ "$hostname" =~ ^[A-Za-z0-9.-]+$ ]] || { echo "访问地址只能是域名或 IPv4。" >&2; exit 2; }
  [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || {
    echo "端口必须是 1-65535 的整数。" >&2
    exit 2
  }
  database_password="$(offline_random_hex 24)"
  master_secret="$(offline_random_hex 32)"
  admin_password="$(offline_generated_password)"
  portal_password="$(offline_generated_password)"
  feed_token="$(offline_random_hex 32)"
  offline_generate_certificate "cloud" "$hostname"
  umask 077
  cat > "$OFFLINE_ENV_FILE" <<EOF
SENTINEL_IMAGE_TAG=$OFFLINE_IMAGE_TAG
SENTINEL_CLOUD_BIND_ADDRESS=0.0.0.0
SENTINEL_CLOUD_HOST_PORT=$port

POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=$database_password
DATABASE_URL=postgresql://sentinel:$database_password@cloud-postgres:5432/sentinel
REDIS_URL=redis://cloud-redis:6379

SENTINEL_SECRET=$master_secret
SENTINEL_ADMIN_ACCOUNT=operator
SENTINEL_ADMIN_NAME=平台管理员
SENTINEL_ADMIN_PASSWORD=$admin_password
SENTINEL_PORTAL_ACCOUNT=analyst
SENTINEL_PORTAL_NAME=情报分析员
SENTINEL_PORTAL_PASSWORD=$portal_password

SENTINEL_PUBLIC_BASE_URL=https://$hostname:$port
SENTINEL_TLS_CERT_HOST_PATH=$OFFLINE_GENERATED_CERT_PATH
SENTINEL_TLS_KEY_HOST_PATH=$OFFLINE_GENERATED_KEY_PATH

SENTINEL_SEED_DEMO_DATA=0
WATCHVULN_FEED_TOKEN=$feed_token
EOF
  chmod 600 "$OFFLINE_ENV_FILE"
  echo "运营平台配置和自签名证书已生成。"
  echo "运营管理员：operator"
  echo "运营管理员初始密码：$admin_password"
  echo "情报门户账号：analyst"
  echo "情报门户初始密码：$portal_password"
  echo "请立即安全保存上述密码，并在首次登录后修改。"
}

offline_show_url() {
  echo "运营平台已启动：$(offline_env_value SENTINEL_PUBLIC_BASE_URL)/admin"
}

source "$OFFLINE_ROOT/scripts/_offline-runtime.sh"
offline_main "$@"
