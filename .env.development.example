# `make dev-init` 会自动生成根目录 `.env.development`。本文件仅用于说明可配置项。
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-a-url-safe-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379

CLOUD_HOST=127.0.0.1
CLOUD_PORT=8787
CLOUD_ADMIN_PORT=5174
SENTINEL_SECRET=replace-with-at-least-32-random-characters
SENTINEL_ADMIN_ACCOUNT=operator
SENTINEL_ADMIN_PASSWORD=replace-with-a-strong-local-password
SENTINEL_PORTAL_ACCOUNT=analyst
SENTINEL_PORTAL_PASSWORD=replace-with-a-strong-local-password
SENTINEL_SEED_DEMO_DATA=1
