flowchart TB
  subgraph SOURCE["数据源与运营"]
    direction LR
    OP["运营管理员"]
    UP["文件录入<br/>XLSX / ZIP / DOCX / HTML"]
    TI["第三方情报源<br/>凭据 / 资产 / 漏洞 / JSON API"]
  end

  subgraph CLOUD["Sentinel Cloud · 云端运营平台"]
    direction LR
    UI["管理后台<br/>HTTPS :8787"]
    API["Cloud API<br/>认证 · 业务 · 云地 OpenAPI"]
    PG[("PostgreSQL<br/>权威业务库")]
    OUT["事务 Outbox"]
    MQ[("Redis / BullMQ")]

    subgraph WORKERS["四类独立 Worker"]
      direction TB
      SCH["scheduler<br/>动态计划 · Outbox 投递"]
      SNAP["snapshot<br/>租户投影 · 快照构建"]
      IO["io<br/>采集 · 文件处理 · 归一化写库"]
      MAIN["maintenance<br/>会话 · 快照 · 历史清理"]
    end

    STORE[("快照与业务文件存储<br/>Manifest · 加密内容 · 附件")]

    UI <--> API
    API <--> PG
    PG --> OUT
    OUT --> MQ
    MQ --> SCH
    MQ --> SNAP
    MQ --> IO
    MQ --> MAIN
    SNAP --> STORE
  end

  subgraph CHANNEL["云地安全通道"]
    direction LR
    CTRL["HTTPS / TLS 1.3<br/>OpenAPI Key · 配置 · 许可证"]
    DATA["API Pull<br/>ETag / 304 · Manifest · 加密快照 · 附件"]
    CRYPTO["完整性与机密性<br/>SHA-256 · 签名 · AES-256-GCM / HKDF"]
    STATUS["Edge -> Cloud<br/>同步状态 · 心跳"]
  end

  subgraph EDGE["Sentinel Edge · 地端交付平台"]
    direction LR
    SYNC["同步引擎<br/>启动同步 + 周期拉取"]
    VERIFY["身份与许可证校验<br/>哈希 -> 签名 -> 解密"]
    EPG[("PostgreSQL<br/>最近成功只读投影")]
    FILES[("SHA-256<br/>内容寻址文件")]
    ES["Edge Server + Portal<br/>HTTPS :8792"]
    USER["情报用户"]

    SYNC --> VERIFY
    VERIFY -->|"单事务原子替换"| EPG
    VERIFY -->|"校验后原子落盘"| FILES
    EPG --> ES
    FILES --> ES
    ES --> USER
  end

  OP --> UI
  UP --> API
  TI -->|"受控 HTTPS 采集"| IO
  API --> CTRL
  STORE --> DATA
  CTRL --> SYNC
  DATA --> CRYPTO
  CRYPTO --> SYNC

  classDef human fill:#fff7df,stroke:#b7791f,color:#3d2b0f,stroke-width:1.5px;
  classDef service fill:#e8f2ff,stroke:#2563a5,color:#102a43,stroke-width:1.5px;
  classDef worker fill:#e8fbf4,stroke:#13835e,color:#12372a,stroke-width:1.5px;
  classDef data fill:#f3efff,stroke:#6d55a4,color:#2b2340,stroke-width:1.5px;
  classDef security fill:#eef8fb,stroke:#16819a,color:#12343d,stroke-width:1.5px;
  class OP,UP,TI,USER human;
  class UI,API,ES,SYNC service;
  class SCH,SNAP,IO,MAIN worker;
  class PG,OUT,MQ,STORE,EPG,FILES data;
  class CTRL,DATA,CRYPTO,STATUS,VERIFY security;

  style SOURCE fill:#fffdf7,stroke:#d8b25c,stroke-width:2px
  style CLOUD fill:#f7fbff,stroke:#2563a5,stroke-width:2px
  style WORKERS fill:#f3fffa,stroke:#64a98e,stroke-width:1px
  style CHANNEL fill:#f6fcfd,stroke:#16819a,stroke-width:2px
  style EDGE fill:#f8fff9,stroke:#2f855a,stroke-width:2px
