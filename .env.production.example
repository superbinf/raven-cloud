# Cloud production deployment. Copy to .env.production and keep it private.
SENTINEL_IMAGE_TAG=local
SENTINEL_CLOUD_BIND_ADDRESS=0.0.0.0
SENTINEL_CLOUD_HOST_PORT=8787

POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-url-safe-database-password
DATABASE_URL=postgresql://sentinel:replace-with-url-safe-database-password@cloud-postgres:5432/sentinel
REDIS_URL=redis://cloud-redis:6379

SENTINEL_SECRET=replace-with-at-least-32-random-characters
SENTINEL_ADMIN_ACCOUNT=operator
SENTINEL_ADMIN_NAME=平台管理员
SENTINEL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SENTINEL_PORTAL_ACCOUNT=analyst
SENTINEL_PORTAL_NAME=情报分析员
SENTINEL_PORTAL_PASSWORD=replace-with-a-strong-portal-password

# The certificate SAN must cover the host in this URL.
SENTINEL_PUBLIC_BASE_URL=https://ti.example.com:8787
SENTINEL_TLS_CERT_HOST_PATH=/absolute/path/to/tls/cloud.crt
SENTINEL_TLS_KEY_HOST_PATH=/absolute/path/to/tls/cloud.key

# Optional cross-origin Admin address. Same-origin deployment does not need this.
# SENTINEL_CORS_ORIGINS=https://admin.example.com
# SENTINEL_SNAPSHOT_WORKER_CONCURRENCY=1
# SENTINEL_COLLECTION_WORKER_CONCURRENCY=4
# Set a unique ID per physical/virtual Worker host. Processes with the same ID are managed as one logical node.
# SENTINEL_WORKER_NODE_ID=worker-shanghai-01
# SENTINEL_WORKER_NODE_NAME=上海 Worker 01
# SENTINEL_SEED_DEMO_DATA=0

# Optional vulnerability feed and provider credentials.
WATCHVULN_FEED_TOKEN=replace-with-a-long-random-feed-token
# QIANXIN_TI_TOKEN=
# QIANXIN_TI_TOKEN_HEADER=Authorization
