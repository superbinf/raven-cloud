{
  "name": "sentinel-threat-intelligence-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @sentinel/api-server",
    "dev:worker": "npm run dev:worker -w @sentinel/api-server",
    "dev:portal": "npm run dev -w @sentinel/portal-web",
    "dev:admin": "npm run dev -w @sentinel/admin-web",
    "start:api": "npm run start -w @sentinel/api-server",
    "start:worker": "npm run start:worker -w @sentinel/api-server",
    "start:worker:scheduler": "npm run start:worker:scheduler -w @sentinel/api-server",
    "start:worker:snapshot": "npm run start:worker:snapshot -w @sentinel/api-server",
    "start:worker:io": "npm run start:worker:io -w @sentinel/api-server",
    "start:worker:maintenance": "npm run start:worker:maintenance -w @sentinel/api-server",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose stop postgres redis",
    "watchvuln:up": "docker compose --profile vulnerability-feed up -d --build watchvuln",
    "watchvuln:down": "docker compose --profile vulnerability-feed stop watchvuln",
    "prod:init": "node scripts/production.mjs init",
    "prod:start": "node scripts/production.mjs start",
    "prod:restart": "node scripts/production.mjs restart",
    "prod:stop": "node scripts/production.mjs stop",
    "prod:status": "node scripts/production.mjs status",
    "prod:logs": "node scripts/production.mjs logs",
    "prod:config": "node scripts/production.mjs config",
    "db:migrate": "npm run db:migrate -w @sentinel/api-server",
    "db:seed:fingerprint-icons": "npm run db:seed:fingerprint-icons -w @sentinel/api-server",
    "db:migrate:sqlite": "npm run db:migrate:sqlite -w @sentinel/api-server",
    "build": "npm run build -w @sentinel/admin-web",
    "lint": "eslint . && node scripts/check-dependency-cycles.mjs",
    "typecheck": "npm run typecheck -w @sentinel/contracts && npm run typecheck -w @sentinel/distribution && npm run typecheck -w @sentinel/file-preview && npm run typecheck -w @sentinel/transport-security && npm run typecheck -w @sentinel/admin-web",
    "test": "npm run test -w @sentinel/auth-captcha && npm run test -w @sentinel/contracts && npm run test -w @sentinel/distribution && npm run test -w @sentinel/file-preview && npm run test -w @sentinel/transport-security && npm run test -w @sentinel/api-server && npm run test:e2e",
    "test:e2e": "node --test tests/e2e/cloud-edge/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.39.5",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
